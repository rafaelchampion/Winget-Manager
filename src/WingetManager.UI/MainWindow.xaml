<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WingetManager.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WingetManager.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WingetManager.UI.ViewModels"
    Title="Winget Manager"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="Winget Manager"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Apps"
                    IsSelected="True"
                    Tag="apps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Discover" Tag="discover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>

        <!-- Docked Activity & Queue Bottom Bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{x:Bind QueueViewModel.QueueBarVisibility, Mode=OneWay}">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Expanded Activity Drawer -->
                <Border Grid.Row="0" 
                        MaxHeight="220"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{x:Bind QueueViewModel.PanelDrawerVisibility, Mode=OneWay}">
                    <Grid Padding="20,12,20,12" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Active Upgrades" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button Content="Clear Finished" FontSize="11" Padding="8,4,8,4"
                                        Command="{x:Bind QueueViewModel.ClearCompletedCommand}" />
                                <Button Content="Cancel All" FontSize="11" Padding="8,4,8,4"
                                        Command="{x:Bind QueueViewModel.CancelAllCommand}" 
                                        IsEnabled="{x:Bind QueueViewModel.HasActiveJobs, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind QueueViewModel.Items, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:UpgradeProgressItemViewModel">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8,12,8"
                                            Margin="0,2,0,2">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind PackageName}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{x:Bind PackageId}" Style="{ThemeResource CaptionTextBlockStyle}" 
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ProgressBar Value="{x:Bind ProgressPercentage, Mode=OneWay}" 
                                                             IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" 
                                                             Maximum="100" Height="3" Margin="0,6,0,3" />
                                                <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" 
                                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Cancel button -->
                                            <Button Grid.Column="1" Content="Cancel" FontSize="11" Padding="8,3,8,3"
                                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{x:Bind CancelVisibility, Mode=OneWay}"
                                                    Click="OnCancelQueueItemClicked" />

                                            <!-- Dismiss button -->
                                            <Button Grid.Column="2" Padding="6,4,6,4"
                                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{x:Bind DismissVisibility, Mode=OneWay}"
                                                    Click="OnDismissQueueItemClicked"
                                                    ToolTipService.ToolTip="Dismiss">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Collapsed Dock Bar -->
                <Grid Grid.Row="1" Height="44" Padding="20,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Summary -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing IsActive="{x:Bind QueueViewModel.HasActiveJobs, Mode=OneWay}" Width="16" Height="16" 
                                      Visibility="{x:Bind QueueViewModel.ActiveJobsVisibility, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  Visibility="{x:Bind QueueViewModel.IdleJobsVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind QueueViewModel.SummaryStatusText, Mode=OneWay}" 
                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Cancel All" FontSize="12" Padding="10,4,10,4"
                                Command="{x:Bind QueueViewModel.CancelAllCommand}"
                                Visibility="{x:Bind QueueViewModel.ActiveJobsVisibility, Mode=OneWay}" />
                        <Button Content="Clear" FontSize="12" Padding="10,4,10,4"
                                Command="{x:Bind QueueViewModel.ClearCompletedCommand}"
                                Visibility="{x:Bind QueueViewModel.IdleJobsVisibility, Mode=OneWay}" />
                        
                        <!-- Toggle Drawer Button -->
                        <Button Command="{x:Bind QueueViewModel.TogglePanelCommand}" Padding="8,5,8,5"
                                ToolTipService.ToolTip="Toggle Activity Details">
                            <FontIcon Glyph="&#xE70E;" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
