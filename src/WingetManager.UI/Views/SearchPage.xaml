<Page
    x:Class="WingetManager.UI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WingetManager.UI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowDefinitions="Auto,Auto,*">
        <!-- Search Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Search &amp; Install" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Text="Find and install packages directly from the community Winget repository." 
                       Style="{ThemeResource BodySubtleTextBlockStyle}" 
                       Margin="0,4,0,16" />

            <Grid MaxWidth="600" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox PlaceholderText="Search by name, publisher, or ID (e.g. Git, VS Code, Discord)..."
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                         KeyDown="OnSearchBoxKeyDown" />

                <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" 
                        Margin="8,0,0,0" 
                        Command="{x:Bind ViewModel.SearchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Width="16" Height="16" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE721;" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Notification -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                 Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                 Severity="Informational" 
                 Margin="0,0,0,16" />

        <!-- Results -->
        <Grid Grid.Row="2">
            <!-- Search state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" 
                        Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="Querying Winget repository..." Style="{ThemeResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <ListView ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}" SelectionMode="None"
                      Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackageItemViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14,16,14"
                                Margin="0,4,0,4">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{x:Bind Id}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,4,8,4" VerticalAlignment="Center" Margin="16,0,24,0">
                                    <TextBlock Text="{x:Bind AvailableVersion}" FontSize="12" FontFamily="Consolas, Cascadia Code, Courier New" />
                                </Border>

                                <Button Grid.Column="2" Content="Install" Style="{ThemeResource AccentButtonStyle}"
                                        Click="OnInstallClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
