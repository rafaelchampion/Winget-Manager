<Page
    x:Class="WingetManager.UI.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WingetManager.UI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,16" RowDefinitions="Auto,Auto,Auto,*">
        <!-- Header row -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Apps" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <TextBlock Text="{x:Bind ViewModel.TotalAppsCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} apps installed'}" 
                               Style="{ThemeResource BodySubtleTextBlockStyle}" />
                    <TextBlock Text="·" Style="{ThemeResource BodySubtleTextBlockStyle}" 
                               Visibility="{x:Bind ViewModel.LastScannedText, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.LastScannedText, Mode=OneWay}" 
                               Style="{ThemeResource BodySubtleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Search Box -->
                <TextBox Width="240" PlaceholderText="Search installed apps..."
                         Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Refresh / Scan Button -->
                <Button Command="{x:Bind ViewModel.ScanCommand}" ToolTipService.ToolTip="Check for updates">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="14" Height="14" 
                                      Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE72C;" FontSize="13" 
                                  Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock Text="Check updates" />
                    </StackPanel>
                </Button>

                <!-- 1-Click Update All Button -->
                <Button Style="{ThemeResource AccentButtonStyle}" 
                        Command="{x:Bind ViewModel.UpgradeAllUpdatesCommand}"
                        Visibility="{x:Bind ViewModel.HasUpdates, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.UpdatesAvailableCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}Update all ({0})'}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter Chips Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- All Filter Button -->
                <Button Click="OnFilterAllClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="All" />
                        <TextBlock Text="{x:Bind ViewModel.TotalAppsCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}({0})'}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Updates Filter Button -->
                <Button Click="OnFilterUpdatesClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Updates" />
                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="10" Padding="6,1,6,1" 
                                Visibility="{x:Bind ViewModel.HasUpdates, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.UpdatesAvailableCount, Mode=OneWay}" 
                                       FontSize="11" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Protected Filter Button -->
                <Button Click="OnFilterProtectedClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Protected" />
                        <TextBlock Text="{x:Bind ViewModel.ProtectedCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}({0})'}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Multi-selection batch bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        Visibility="{x:Bind ViewModel.HasSelectedPackages, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} selected'}" 
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Content="Update Selected" Style="{ThemeResource AccentButtonStyle}" 
                        Command="{x:Bind ViewModel.UpgradeSelectedCommand}" />
                <Button Content="Deselect All" Command="{x:Bind ViewModel.DeselectAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- Feedback InfoBar -->
        <InfoBar Grid.Row="2"
                 IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                 Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                 Margin="0,0,0,10" />

        <!-- Main Package List -->
        <Grid Grid.Row="3">
            <!-- Empty state when no apps match -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind ViewModel.FilteredPackages.Count, Mode=OneWay, Converter={StaticResource IntToZeroVisibilityConverter}}">
                <FontIcon Glyph="&#xE74C;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="No apps found" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="No installed apps match your current search or filter." 
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Package Rows -->
            <ListView ItemsSource="{x:Bind ViewModel.FilteredPackages, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackageItemViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8,12,8"
                                Margin="0,3,0,3">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                <!-- Selection CheckBox -->
                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" 
                                          MinWidth="32" Margin="0,0,8,0" VerticalAlignment="Center" />

                                <!-- Initials Avatar -->
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="6" 
                                        Background="{x:Bind Name, Converter={StaticResource NameToAvatarBrushConverter}}"
                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Initials}" Foreground="White" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Title, ID, Source -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Id}" Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Source, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}• {0}'}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind HasSource, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Version / Update Indicator -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <!-- When Update is Available -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                Visibility="{x:Bind HasUpdate, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind InstalledVersion}" FontSize="12" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="6,2,6,2">
                                            <TextBlock Text="{x:Bind AvailableVersion}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- When Up to Date -->
                                    <TextBlock Text="{x:Bind InstalledVersion, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}v{0}'}" 
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                               Visibility="{x:Bind HasUpdate, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                    <!-- Pinned Badge -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2,6,2"
                                            Visibility="{x:Bind IsPinned, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE718;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="Pinned" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Excluded Badge -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2,6,2"
                                            Visibility="{x:Bind IsExcluded, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="Excluded" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Active Upgrade Status (In-Row) -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="130"
                                            Visibility="{x:Bind HasUpgradeProgress, Mode=OneWay}">
                                    <ProgressBar Value="{x:Bind UpgradePercentage, Mode=OneWay}" 
                                                 IsIndeterminate="{x:Bind IsUpgradeIndeterminate, Mode=OneWay}" 
                                                 Maximum="100" Height="4" />
                                    <TextBlock Text="{x:Bind UpgradeStatusMessage, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                               FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- 1-Click Update Button for this package -->
                                    <Button Style="{ThemeResource AccentButtonStyle}" Padding="10,5,10,5"
                                            Click="OnUpgradeItemClicked"
                                            Visibility="{x:Bind HasUpdate, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                                            <TextBlock Text="Update" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!-- More Actions Dropdown Menu -->
                                    <DropDownButton Padding="6,5,6,5">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" />
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource PinButtonLabelConverter}}" 
                                                                Click="OnTogglePinClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE718;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind IsExcluded, Mode=OneWay, Converter={StaticResource ExcludeButtonLabelConverter}}" 
                                                                Click="OnToggleExclusionClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE711;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Copy Package ID" Click="OnCopyPackageIdClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
