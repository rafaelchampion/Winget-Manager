<Page
    x:Class="WingetManager.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:entities="using:WingetManager.Domain.Entities"
    xmlns:vm="using:WingetManager.UI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel MaxWidth="800" Spacing="24" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Manage app behavior, concurrency, exclusions, and preferences." 
                           Style="{ThemeResource BodySubtleTextBlockStyle}" />
            </StackPanel>

            <!-- Appearance Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance &amp; Language" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="App Theme" FontWeight="SemiBold" />
                            <TextBlock Text="Select whether to follow system colors or force light/dark." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.PreferredTheme, Mode=TwoWay, Converter={StaticResource ThemeToIndexConverter}}" Width="140">
                            <ComboBoxItem Content="System default" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Language" FontWeight="SemiBold" />
                            <TextBlock Text="Display language for app text and commands." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}" SelectedValuePath="Tag" Width="140">
                            <ComboBoxItem Content="English" Tag="en-US" />
                            <ComboBoxItem Content="Português" Tag="pt-BR" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Upgrades & Concurrency Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Simultaneous Upgrades" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Maximum Concurrent Upgrades" FontWeight="SemiBold" />
                            <TextBlock Text="Number of packages that can be upgraded at the same time." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Value="{x:Bind ViewModel.MaxConcurrentUpgrades, Mode=TwoWay}" Minimum="1" Maximum="8" StepFrequency="1" Width="140" />
                            <TextBlock Text="{x:Bind ViewModel.MaxConcurrentUpgrades, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center" Width="20" />
                        </StackPanel>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Auto-scan on Startup" FontWeight="SemiBold" />
                            <TextBlock Text="Automatically check for newer package versions when launching." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoScanOnStartup, Mode=TwoWay}" OnContent="Enabled" OffContent="Disabled" />
                    </Grid>

                    <MenuFlyoutSeparator />

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cache Expiration (minutes)" FontWeight="SemiBold" />
                            <TextBlock Text="Duration to keep scanned packages cached before requesting Winget again." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Value="{x:Bind ViewModel.CacheTtlMinutes, Mode=TwoWay}" Minimum="1" Maximum="120" StepFrequency="5" Width="140" />
                            <TextBlock Text="{x:Bind ViewModel.CacheTtlMinutes, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center" Width="24" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Exclusions Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Excluded Packages" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Packages listed here will never be automatically upgraded or presented in the update dashboard." 
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,8">
                        <TextBox PlaceholderText="Enter Package ID to exclude (e.g. Adobe.Acrobat.Reader)..."
                                 Text="{x:Bind ViewModel.NewExclusionId, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Add Exclusion" Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.AddExclusionCommand}" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.ExcludedPackageIds, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,4,0,4">
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Content="Remove" Click="OnRemoveExclusionClicked" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Version Pins Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Version Pins" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Keep specific packages pinned to a desired version without updating." 
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnDefinitions="*,*,Auto" Margin="0,8,0,8">
                        <TextBox PlaceholderText="Package ID (e.g. Python.Python.3.11)..."
                                 Text="{x:Bind ViewModel.NewPinId, Mode=TwoWay}" Margin="0,0,4,0" />
                        <TextBox Grid.Column="1" PlaceholderText="Version (e.g. 3.11.9)..."
                                 Text="{x:Bind ViewModel.NewPinVersion, Mode=TwoWay}" Margin="4,0,4,0" />
                        <Button Grid.Column="2" Content="Pin Version" Margin="4,0,0,0"
                                Command="{x:Bind ViewModel.AddPinCommand}" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.PinnedVersions, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="entities:VersionPin">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4,0,4">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind PackageId}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Reason}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,4,8,4" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <TextBlock Text="{x:Bind PinnedVersion}" FontSize="12" FontFamily="Consolas, Cascadia Code, Courier New" />
                                    </Border>
                                    <Button Grid.Column="2" Content="Unpin" Click="OnRemovePinClicked" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button Content="Save Changes" Style="{ThemeResource AccentButtonStyle}" 
                    Command="{x:Bind ViewModel.SaveSettingsCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind ViewModel.SaveMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
